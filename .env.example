# ── Sécurité ──────────────────────────────────────────────
# ADMIN_TOKEN : OBLIGATOIRE si le serveur est en ligne. Protège /keys, /github, /telegram, /whatsapp.
# Sans lui, ces routes ne répondent qu'depuis la machine locale. Choisis une longue valeur aléatoire.
ADMIN_TOKEN=""

# ── Données de marché (au moins une source recommandée ; Yahoo Finance sert de repli sans clé) ──
TWELVE_DATA_API_KEY=""
# Finnhub : calendrier économique (+ bougies forex selon ton plan)
FINNHUB_API_KEY=""

# ── Notifications (optionnel, tu peux aussi les saisir dans Réglages) ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_RECIPIENT=""

# ── Publication GitHub (optionnel) ──
GITHUB_TOKEN=""

# ── Divers ──
# ALLOW_SIMULATOR=true : autorise des bougies ALÉATOIRES de démonstration (étiquetées « simulated »,
# les signaux restent bloqués). À ne PAS activer pour trader.
ALLOW_SIMULATOR="false"
# BZ_PERSIST=false : ne pas écrire le journal sur disque (data/journal.json).
BZ_PERSIST="true"
PORT=3000
